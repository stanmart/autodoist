# Todoist static personal API token (Settings -> Integrations -> Developer)
TODOIST_API_TOKEN=

# Shared secret for POST /internal/sync (X-Sync-Secret header)
SYNC_SECRET=

# Public HTTPS base URL of this MCP server (required unless AUTH_DISABLED=true)
MCP_BASE_URL=https://todoist-mcp.example.com

# Pocket ID OIDC/OAuth 2.1 issuer
POCKET_ID_ISSUER=https://id.csigahaz.eu

# Optional expected JWT audience (set if Gemini sends RFC 8707 resource or fixed client_id)
JWT_AUDIENCE=

# Comma-separated Pocket ID `sub` user IDs allowed to access the MCP server
ALLOWED_USER_SUBS=

# SQLite database path
DB_PATH=data/autodoist.db

# Path to TOML rules configuration
AUTODOIST_CONFIG=config.toml

# Local development only: set to true to bypass OAuth/JWT checks
AUTH_DISABLED=false
